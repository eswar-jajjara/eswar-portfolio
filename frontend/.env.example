# Local Spring Boot API URL.
VITE_API_BASE_URL=http://localhost:8080

# Optional public OAuth Web client ID. Google sign-in stays hidden when empty.
# The backend must use the same GOOGLE_CLIENT_ID and the allowlisted GOOGLE_ADMIN_EMAIL.
VITE_GOOGLE_CLIENT_ID=

# Optional canonical public URL. GitHub Pages CI supplies this automatically
# to generate absolute Open Graph, robots.txt, and sitemap.xml URLs.
# VITE_SITE_URL=https://YOUR_GITHUB_USERNAME.github.io/REPOSITORY_NAME
