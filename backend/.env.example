# Spring datasource (matches docker-compose.yml's default local port)
DATABASE_URL=jdbc:postgresql://localhost:5433/portfolio
DATABASE_USERNAME=portfolio
DATABASE_PASSWORD=portfolio

# Generate this with: htpasswd -bnBC 12 "" "your-password" | tr -d ':\n'
# Do not commit the resulting .env file.
ADMIN_USERNAME=eswar
ADMIN_PASSWORD_HASH=$2a$12$replace-with-a-real-bcrypt-hash

# Use a random 32+ character value; never commit the real value.
JWT_SECRET=replace-with-a-long-random-jwt-secret-at-least-32-characters

# Comma-separated frontend origins. The local Vite dev server uses port 5181.
# Add the production GitHub Pages URL here before deploying.
CORS_ALLOWED_ORIGINS=http://localhost:5181,http://127.0.0.1:5181,https://YOUR_GITHUB_USERNAME.github.io

# Login protection: after this many failed attempts for the same username/IP pair,
# that pair is temporarily blocked. Keep these values out of source control when
# overriding them for an environment.
AUTH_MAX_FAILED_ATTEMPTS=5
AUTH_LOCKOUT_SECONDS=300
